{
  "name": "cadence",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @cadence/db generate",
    "db:migrate": "pnpm --filter @cadence/db migrate:dev",
    "db:deploy": "pnpm --filter @cadence/db migrate:deploy",
    "db:seed": "pnpm --filter @cadence/db seed",
    "infra:up": "docker compose -f infra/docker-compose.yml up -d",
    "infra:down": "docker compose -f infra/docker-compose.yml down"
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "@types/node": "^22.7.0",
    "eslint": "^9.12.0",
    "eslint-plugin-jsx-a11y": "^6",
    "prettier": "^3.3.3",
    "turbo": "^2.1.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8",
    "vitest": "^2.1.3"
  }
}
