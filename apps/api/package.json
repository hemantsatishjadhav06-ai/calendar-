{
  "name": "@cadence/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --import @swc-node/register/esm-register src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --import @swc-node/register/esm-register src/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "schema:emit": "tsx src/graphql/emit-schema.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.650.0",
    "@aws-sdk/s3-request-presigner": "^3.650.0",
    "@cadence/ai": "workspace:*",
    "@cadence/config": "workspace:*",
    "@cadence/connectors": "workspace:*",
    "@cadence/db": "workspace:*",
    "@cadence/domain": "workspace:*",
    "@cadence/entitlements": "workspace:*",
    "@cadence/mail": "workspace:*",
    "@cadence/network-rules": "workspace:*",
    "@cadence/token-vault": "workspace:*",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@pothos/core": "^4.3.0",
    "@pothos/plugin-complexity": "^4.1.0",
    "@pothos/plugin-errors": "^4.2.0",
    "@pothos/plugin-prisma": "^4.4.0",
    "@pothos/plugin-relay": "^4.3.0",
    "@pothos/plugin-scope-auth": "^4.1.0",
    "@simplewebauthn/server": "11",
    "argon2": "^0.41.1",
    "bullmq": "^5.13.0",
    "cookie-parser": "^1.4.6",
    "express": "^4.21.0",
    "graphql": "^16.9.0",
    "graphql-scalars": "^1.23.0",
    "graphql-yoga": "^5.7.0",
    "ioredis": "^5.4.1",
    "luxon": "^3.5.0",
    "nanoid": "^5.0.7",
    "otplib": "^12.0.1",
    "pino": "^9.4.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "stripe": "^17.2.0",
    "zod": "^3.23.8"
